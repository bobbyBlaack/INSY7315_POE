@{
    ViewData["Title"] = "Ollama Test";
}

<h2>🧠 Test Ollama Connection</h2>

<input type="text" id="messageInput" placeholder="Ask Ollama..." style="width: 60%" />
<button id="sendBtn">Send</button>

<p><strong>Response:</strong></p>
<div id="responseBox" style="white-space: pre-wrap; background: #f5f5f5; padding: 10px; border-radius: 5px;"></div>

<script>
    document.getElementById("sendBtn").addEventListener("click", async () => {
        const msg = document.getElementById("messageInput").value.trim();
        if (!msg) return;

        const res = await fetch("/Ollama/AskOllama", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: new URLSearchParams({ message: msg })
        });

        const data = await res.json();
        document.getElementById("responseBox").innerText = data.response;
    });
</script>
