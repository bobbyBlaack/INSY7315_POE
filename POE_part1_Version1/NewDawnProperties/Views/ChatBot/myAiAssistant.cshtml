@{
    ViewData["Title"] = "AI Assistant";
}

<head>
    <style>
        /* ===== Page Background ===== */
        body {
            background-color: #fff8e1; /* same soft background as chat-container base */
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            flex-direction: row;
        }

        /* ===== Chat Container ===== */
        .chat-container {
            background-color: #fff8e1;
            border-radius: 12px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            height: 600px;
            width: 600px;
            max-width: 90vw;
            margin: 0 auto; /* horizontal centering if flex fails */
        }

        /* ===== Chat Box (Messages Area) ===== */
        .chat-box {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            background-color: #fff3c2;
            border-radius: 12px;
        }

        /* ===== Chat Messages ===== */
        .chat-message {
            padding: 10px 15px;
            border-radius: 18px;
            max-width: 75%;
            word-wrap: break-word;
            position: relative;
        }

        .user-message {
            align-self: flex-end;
            background-color: #FF9D00;
            color: black;
        }

        .ai-message {
            align-self: flex-start;
            background-color: #E6B566;
            color: black;
        }

        
        /* ===== Chat Input Area ===== */
        .chat-input-area {
            display: flex;
            padding: 15px;
            border-top: 2px solid #f1e2b1;
            gap: 10px;
        }

        .chat-input {
            flex: 1;
            border: none;
            outline: none;
            padding: 10px;
            border-radius: 20px;
            background-color: #fff3c2;
            font-size: 16px;
        }

        .send-button {
            border: none;
            background-color: #FF9D00;
            color: black;
            border-radius: 50%;
            width: 45px;
            height: 45px;
            font-size: 18px;
            cursor: pointer;
            transition: 0.2s;
        }

        .send-button:hover {
            transform: scale(1.1);
        }

        /* ===== Scrollbar Styling ===== */
        .chat-box::-webkit-scrollbar {
            width: 6px;
        }

        .chat-box::-webkit-scrollbar-thumb {
            background-color: #FFD580;
            border-radius: 3px;
        }

        /* ===== Navbar ===== */
        #navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #E6B566;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 15px 0;
            z-index: 1000;
            font-weight: bold;
        }

            #navbar a {
                color: black;
                text-decoration: none;
                padding: 10px 15px;
                transition: color 0.3s;
            }

                #navbar a:hover {
                    color: white;
                }

            #navbar #logo {
                font-size: 20px;
                font-weight: bold;
            }

        /* ===== Page Layout ===== */
        #dashboard-container {
            margin-top: 120px;
            padding: 20px;
        }

        h1 {
            margin-bottom: 20px;
        }

        /* ===== Filter Section ===== */
        #filter-section {
            background-color: #f0f0f0;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

            #filter-section input, #filter-section button {
                padding: 8px;
                border-radius: 6px;
                border: 1px solid #ccc;
                font-size: 14px;
            }

            #filter-section button {
                background-color: #E6B566;
                cursor: pointer;
                font-weight: bold;
            }

                #filter-section button:hover {
                    background-color: #d39f58;
                }

        /* ===== Grid Layout ===== */
        #listings-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
            gap: 20px;
        }

        /* ===== Listing Cards ===== */
        .listing-card {
            background-color: white;
            border-radius: 10px;
            padding: 15px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
            transition: transform 0.2s;
            cursor: pointer;
        }

            .listing-card:hover {
                transform: scale(1.02);
            }

        .listing-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .listing-details {
            display: none;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #ccc;
        }

        .property-image {
            max-width: 100%;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .video-preview {
            display: none;
            margin-top: 10px;
        }

        .expand-btn, .video-btn, .apply-btn {
            padding: 6px 12px;
            margin-right: 5px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .expand-btn {
            background-color: #E6B566;
        }

        .video-btn {
            background-color: #FF9D00;
        }

        .apply-btn {
            background-color: #4CAF50;
            color: white;
        }

        .expand-btn:hover {
            background-color: #d39f58;
        }

        .video-btn:hover {
            background-color: #d87a00;
        }

        .apply-btn:hover {
            background-color: #3e8e41;
        }

    </style>


</head>

<!-- ===== Navbar ===== -->
<div id="navbar">
    <a href="#" id="logo">New Dawn</a>
    <a asp-controller="PropManager" asp-action="PropManDashboard">Dashboard</a>
    <a asp-controller="PropManager" asp-action="ManagerListing">Update Listings</a>
    <a asp-controller="PropManager" asp-action="ManagerLease">Manage Leases</a>
    <a asp-controller="PropManager" asp-action="ManagerEscalation">Escalations</a>
    <a asp-controller="PropManager" asp-action="ManagerNotif">Notifications</a>
    <a asp-controller="Home" asp-action="Profile">Profile</a>
</div>


<div class="chat-container">
    <div class="chat-box" id="chatBox">
        <div class="chat-message ai-message">
            👋 Hi there! I’m your NewDawn Assistant. How can I help you today?
        </div>
    </div>

    <div class="chat-input-area">
        <input type="text" id="userInput" class="chat-input" placeholder="Type your message..." />
        <button id="sendBtn" class="send-button">➤</button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
    const chatBox = document.getElementById("chatBox");
    const input = document.getElementById("userInput");
    const sendBtn = document.getElementById("sendBtn");

    sendBtn.addEventListener("click", async () => {
        const message = input.value.trim();
        if (!message) return;

        // Append user's message
        appendMessage("user", message);
        input.value = "";

        // ===== Show typing bubble =====
        const typingBubble = document.createElement("div");
        typingBubble.classList.add("ai-typing");
        typingBubble.innerHTML = `<span></span><span></span><span></span>`;
        chatBox.appendChild(typingBubble);
        chatBox.scrollTop = chatBox.scrollHeight;

        // ===== Fetch AI Response =====
        const response = await fetch("/ChatBot/SendMessage", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: new URLSearchParams({ message })
        });

        const data = await response.json();

        // ===== Remove typing bubble and append AI response =====
        typingBubble.remove();
        appendMessage("ai", data.response);
    });

    function appendMessage(sender, text) {
        const msgDiv = document.createElement("div");
        msgDiv.classList.add("chat-message", sender === "user" ? "user-message" : "ai-message");
        msgDiv.textContent = text;
        chatBox.appendChild(msgDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
    }
});

</script>
