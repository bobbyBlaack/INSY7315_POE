@model List<NewDawnProperties.Controllers.EscalationItem>

@{
    ViewData["Title"] = "Escalations";
}

<!-- NAVBAR -->
<style>
    #navbar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background-color: #E6B566;
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding: 15px 0;
        z-index: 1000;
        font-weight: bold;
    }

        #navbar a {
            color: black;
            text-decoration: none;
            padding: 10px 15px;
            transition: color .3s;
        }

            #navbar a:hover {
                color: white;
            }

        #navbar #logo {
            font-size: 20px;
            font-weight: bold;
        }

    body {
        padding-top: 80px;
    }
</style>

<div id="navbar">
    <a href="/Admin/AdminDashboard" id="logo">Company Logo</a>
    <a href="/Admin/AdminDashboard">Dashboard</a>
    <a href="/Admin/Broadcast">Broadcast</a>
    <a href="/Admin/Management">Management</a>
    <a href="/Admin/Escalations">Escalations</a>
    <a href="/Admin/Reports">Reports</a>
</div>

<h1>Escalations</h1>

<table class="table">
    <tr><th>Date</th><th>Name</th><th>Issue</th><th></th></tr>

    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Date.ToShortDateString()</td>
            <td>@e.Name</td>
            <td>@e.Issue</td>
            <td><a href="/Admin/EscalationDetails/@e.Id" class="btn btn-primary btn-sm">View</a></td>
        </tr>
    }
</table>
