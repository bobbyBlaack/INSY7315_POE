@model NewDawnProperties.Controllers.EscalationItem

@{
    ViewData["Title"] = "Escalation Details";
}


<!-- NAVBAR -->
<style>
    #navbar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background-color: #E6B566;
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding: 15px 0;
        z-index: 1000;
        font-weight: bold;
    }

        #navbar a {
            color: black;
            text-decoration: none;
            padding: 10px 15px;
            transition: color .3s;
        }

            #navbar a:hover {
                color: white;
            }

        #navbar #logo {
            font-size: 20px;
            font-weight: bold;
        }

    body {
        padding-top: 80px;
    }
</style>

<div id="navbar">
    <a href="/Admin/AdminDashboard" id="logo">Company Logo</a>
    <a href="/Admin/AdminDashboard">Dashboard</a>
    <a href="/Admin/Broadcast">Broadcast</a>
    <a href="/Admin/Management">Management</a>
    <a href="/Admin/Escalations">Escalations</a>
    <a href="/Admin/Reports">Reports</a>
</div>

<h1>Escalation Details</h1>

<p><strong>Date:</strong> @Model.Date</p>
<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Issue:</strong> @Model.Issue</p>

<a href="/Admin/Escalations" class="btn btn-secondary mt-3">Back</a>
