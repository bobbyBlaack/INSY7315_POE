@model NewDawnProperties.Controllers.AppUser

@{
    ViewData["Title"] = "Edit User";
}


<!-- NAVBAR -->
<style>
    #navbar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background-color: #E6B566;
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding: 15px 0;
        z-index: 1000;
        font-weight: bold;
    }

        #navbar a {
            color: black;
            text-decoration: none;
            padding: 10px 15px;
            transition: color .3s;
        }

            #navbar a:hover {
                color: white;
            }

        #navbar #logo {
            font-size: 20px;
            font-weight: bold;
        }

    body {
        padding-top: 80px;
    }
</style>

<div id="navbar">
    <a href="/Admin/AdminDashboard" id="logo">Company Logo</a>
    <a href="/Admin/AdminDashboard">Dashboard</a>
    <a href="/Admin/Broadcast">Broadcast</a>
    <a href="/Admin/Management">Management</a>
    <a href="/Admin/Escalations">Escalations</a>
    <a href="/Admin/Reports">Reports</a>
</div>

<h1>Edit User</h1>

<form method="post">
    <input type="hidden" asp-for="Id" />

    <label>Name</label>
    <input asp-for="Name" class="form-control" />

    <label>Email</label>
    <input asp-for="Email" class="form-control" />

    <label>Role</label>
    <input asp-for="Role" class="form-control" />

    <label>Active</label>
    <input type="checkbox" asp-for="IsActive" />

    <button class="btn btn-primary mt-3">Save</button>
</form>
