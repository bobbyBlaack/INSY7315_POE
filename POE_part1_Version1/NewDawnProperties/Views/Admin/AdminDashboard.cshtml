@model NewDawnProperties.Models.PropertyModel

@{
    ViewData["Title"] = "Property Manager Dashboard";
}

<head>
    <style>
        /* ===== Navbar ===== */
        #navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #E6B566;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 15px 0;
            z-index: 1000;
            font-weight: bold;
        }

        #navbar a {
            color: black;
            text-decoration: none;
            padding: 10px 15px;
            transition: color 0.3s;
        }

        #navbar a:hover {
            color: white;
        }

        #navbar #logo {
            font-size: 20px;
            font-weight: bold;
        }

        /* ===== Page Layout ===== */
        #dashboard-container {
            margin-top: 80px; /* space for fixed navbar */
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* ===== Top Summary Section ===== */
        #summary-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        #property-title {
            font-size: 28px;
            font-weight: bold;
        }

        .summary-box {
            background-color: #f0f0f0;
            border-radius: 10px;
            padding: 15px;
            min-width: 120px;
            text-align: center;
            flex: 1;
        }

        /* ===== Middle Section Grid ===== */
        #middle-section {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr; /* Tenant list larger, payments & maintenance smaller */
            gap: 20px;
            align-items: center !important;
            flex-direction: row; /* ensure it's row for horizontal centering */
        }

        .scroll-box {
            background-color: #f9f9f9;
            border-radius: 10px;
            padding: 15px;
            max-height: 400px;
            overflow-y: auto;
            width:500px;
            height:300px
        }

        /* ===== Bottom Section Grid ===== */
        #bottom-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            align-items: center !important;
            flex-direction: row; /* ensure it's row for horizontal centering */
        }

        #recent-activity, #notes-box {
            background-color: #f9f9f9;
            border-radius: 10px;
            padding: 15px;
            min-height: 250px;
            overflow-y: auto;
            width: 750px;
            height: 400px
        }

        #notes-textarea {
            width: 100%;
            height: 150px;
            border-radius: 5px;
            border: 1px solid #ccc;
            padding: 5px;
        }

        /* ===== Floating AI Chatbot Icon ===== */
        #ai-chatbot {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background-color: #FF9D00;
            color: black;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(0,0,0,0.2);
            transition: 0.3s;
        }

        #ai-chatbot:hover {
            transform: scale(1.1);
        }
    </style>
</head>

<body>

    <!-- ===== Navbar ===== -->
    <div id="navbar">
        <a href="#" id="logo">Company Logo</a>
        <a href="#">Dashboard</a>
        <a href="#">Update Listings</a>
        <a href="#">Manage Leases</a>
        <a href="#">Escalations</a>
        <a href="#">Notifications</a>
        <a href="#">Profile</a>
    </div>

    <!-- ===== Main Dashboard Container ===== -->
    <div id="dashboard-container">

        <!-- Top Summary -->
        <div id="summary-section">
            <h1 id="property-title">Property Name</h1>
            <div class="summary-box" id="blocks-count">Blocks: 5</div>
            <div class="summary-box" id="units-count">Units: 30</div>
            <div class="summary-box" id="occupied-count">Occupied: 25</div>
        </div>

        <!-- Middle Section -->
        <div id="middle-section">
            <div class="scroll-box" id="tenants-box" style="background-color:lightgray">
                <h3>Tenants</h3>
                <ul>
                    <li>Tenant 1</li>
                    <li>Tenant 2</li>
                    <li>Tenant 3</li>
                </ul>
            </div>

            <div class="scroll-box" id="payments-box" style="background-color:lightgray">
                <h3>Payment Summary</h3>
                <input type="text" id="payment-filter" placeholder="Filter by amount..." style="margin-bottom:10px; width:100%; padding:5px; border-radius:5px; border:1px solid #ccc;">
                <ul>
                    <li>Tenant 1: $500</li>
                    <li>Tenant 2: $450</li>
                </ul>
            </div>

            <div class="scroll-box" id="maintenance-box" style="background-color:lightgray">
                <h3>Maintenance Overview</h3>
                <ul>
                    <li>Request 1 - Pending - 2025-11-12</li>
                    <li>Request 2 - Completed - 2025-11-10</li>
                </ul>
            </div>
        </div>

        <!-- Bottom Section -->
        <div id="bottom-section">
            <div id="recent-activity" style="background-color:lightgray">
                <h3>Recent Activity</h3>
            </div>

            <div id="notes-box" style="background-color:lightgray">
                <h3>Notes</h3>
                <textarea id="notes-textarea" placeholder="Write notes here..."></textarea>
            </div>
        </div>

    </div>

    <!-- Floating AI Chatbot Icon -->
    <div id="ai-chatbot">
    <form asp-controller="ChatBot" asp-action="myAiAssistant">
        
            <button>🤖</button>
            
        
    </form>
    </div>
    

    <!-- ===== Optional jQuery Scripts ===== -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Dynamically add recent activity when tenant is clicked
        $('#tenants-box li').click(function () {
            let tenantName = $(this).text();
            $('#recent-activity').append('<p>Clicked on ' + tenantName + ' at ' + new Date().toLocaleTimeString() + '</p>');
        });

        // Store notes in localStorage
        $('#notes-textarea').on('input', function () {
            localStorage.setItem('propertyNotes', $(this).val());
        });

        // Load saved notes
        $(document).ready(function () {
            let savedNotes = localStorage.getItem('propertyNotes');
            if (savedNotes) {
                $('#notes-textarea').val(savedNotes);
            }
        });
    </script>
</body>
