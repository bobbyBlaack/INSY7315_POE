@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    // Detect caretaker roles
    var userRole = Context.Session.GetString("Role")?.ToLower() ?? "";
    bool isCaretakerRole =
        userRole.Contains("caretaker") ||
        userRole.Contains("care_taker") ||
        userRole.Contains("maintenance") ||
        userRole.Contains("manager") ||
        userRole == "ct";

    bool isFullScreenPage =
        (controller == "Home" && action == "Index") ||
        (controller == "Account" && action == "SignUp") ||
        (controller == "Home" && action == "Profile") ||
        (controller == "CareTaker" && action == "Index");
}

<!DOCTYPE html>
<html lang="@System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["SiteName"]</title>

    <!-- Bootstrap & Custom Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NewDawnProperties.styles.css" asp-append-version="true" />

    <!-- Google Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>

<body>
    <div class="page-wrapper">

        <!-- Navigation Bar-->
        <header>
            @if (!(
                        (controller == "Home" && action == "Index") ||
                        (controller == "Account" && action == "SignUp")
                        ))
            {
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container-fluid">

                        <!-- Brand Name -->
                        <a class="navbar-brand" asp-area=""
                           asp-controller="@(isCaretakerRole ? "CareTaker" : "Home")"
                           asp-action="Index">
                            @Localizer["SiteName"]
                        </a>

                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">

                                <!-- Updated Home Navigation -->
                                <li class="nav-item">
                                    @if (isCaretakerRole)
                                    {
                                        <a class="nav-link text-dark" asp-controller="CareTaker" asp-action="Index">
                                            @Localizer["Home"]
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">
                                            @Localizer["Home"]
                                        </a>
                                    }
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Caretaker" asp-action="Index">
                                        Caretaker Dashboard
                                    </a>
                                </li>

                                <!-- Profile -->
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Profile">
                                        @Localizer["Profile"]
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Communication" asp-action="Index">
                                        Communications
                                    </a>
                                </li>

                            </ul>
                        </div>
                    </div>
                </nav>
            }
        </header>

        <div class="content-wrapper">
            @if (isFullScreenPage)
            {
                <main role="main" class="fullpage-main">
                    @RenderBody()
                </main>
            }
            else
            {
                <div class="container">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
            }
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>