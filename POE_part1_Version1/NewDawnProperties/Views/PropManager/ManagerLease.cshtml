@model List<NewDawnProperties.Models.LeaseModel>

@{
    ViewData["Title"] = "Lease Management";
}

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #fafafa;
            margin: 0;
        }

        #navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #E6B566;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 15px 0;
            z-index: 1000;
            font-weight: bold;
        }

            #navbar a {
                color: black;
                text-decoration: none;
                padding: 10px 15px;
            }

                #navbar a:hover {
                    color: white;
                }

        #dashboard-container {
            margin-top: 90px;
            padding: 20px;
        }

        #control-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        #search-input {
            width: 40%;
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        #status-filter {
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        #add-lease-btn {
            background-color: #FF9D00;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            color: black;
            font-weight: bold;
        }

            #add-lease-btn:hover {
                background-color: #E68A00;
            }

        #summary-section {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }

        .summary-box {
            background-color: #f0f0f0;
            border-radius: 10px;
            padding: 15px;
            flex: 1;
            text-align: center;
        }

        #table-container {
            max-height: 500px;
            overflow-y: auto;
            border-radius: 8px;
            border: 1px solid #ccc;
        }

        #lease-table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

            #lease-table th, #lease-table td {
                padding: 10px;
                border-bottom: 1px solid #ddd;
                text-align: center;
            }

            #lease-table th {
                background-color: #E6B566;
            }

        .view-btn {
            padding: 5px 10px;
            cursor: pointer;
        }

        .expanded-row {
            display: none;
            background-color: #f9f9f9;
        }

        .expanded-content {
            padding: 10px;
            border-top: 1px solid #ccc;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .status-btn {
            margin: 0 5px;
            padding: 5px 10px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .active-btn {
            background-color: #4CAF50;
            color: white;
        }

        .expiring-btn {
            background-color: #FFD700;
            color: black;
        }

        .expired-btn {
            background-color: #f44336;
            color: white;
        }

        .terminated-btn {
            background-color: #888;
            color: white;
        }
    </style>
</head>

<body>
    <div id="navbar">
        <a href="#" id="logo">Company Logo</a>
        <a asp-action="PropManDashboard">Dashboard</a>
        <a asp-action="ManagerListing">Update Listings</a>
        <a asp-action="ManagerLease">Manage Leases</a>
        <a asp-action="ManagerEscalation">Escalations</a>
        <a asp-action="ManagerNotif">Notifications</a>
        <a asp-controller="Home" asp-action="Profile">Profile</a>
    </div>

    <div id="dashboard-container">
        <div id="control-bar">
            <input type="text" id="search-input" placeholder="Search by Tenant or Unit...">
            <select id="status-filter">
                <option value="">All Statuses</option>
                <option value="Active">Active</option>
                <option value="Expiring Soon">Expiring Soon</option>
                <option value="Expired">Expired</option>
                <option value="Terminated">Terminated</option>
            </select>
            <button id="add-lease-btn" onclick="window.location.href='/PropertyManager/AddLease'">+ Add Lease</button>
        </div>

        <div id="summary-section">
            <div class="summary-box">Active Leases: <strong>@Model.Count(l => l.LeaseStatus == 1)</strong></div>
            <div class="summary-box">Expiring Soon: <strong>@Model.Count(l => l.LeaseStatus == 3)</strong></div>
            <div class="summary-box">Expired: <strong>@Model.Count(l => l.LeaseStatus == 2)</strong></div>
            <div class="summary-box">Terminated: <strong>@Model.Count(l => l.LeaseStatus == 4)</strong></div>
        </div>

        <div id="table-container">
            <table id="lease-table">
                <thead>
                    <tr>
                        <th>Lease ID</th>
                        <th>Status</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Rent</th>
                        <th>Room ID</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lease in Model)
                    {
                        <tr data-id="@lease.LeaseID">
                            <td>@lease.LeaseID</td>
                            <td>@lease.LeaseAction</td>
                            <td>@lease.LeaseStart.ToString("yyyy-MM-dd")</td>
                            <td>@lease.LeaseEnd.ToString("yyyy-MM-dd")</td>
                            <td>R @lease.RentAmount</td>
                            <td>@lease.RoomId</td>
                            <td><button class="view-btn">View</button></td>
                        </tr>
                        <tr class="expanded-row" id="expanded-@lease.LeaseID">
                            <td colspan="7">
                                <div class="expanded-content">

                                    <div>
                                        <button class="status-btn active-btn" data-status="1" data-id="@lease.LeaseID">Active</button>
                                        <button class="status-btn expiring-btn" data-status="3" data-id="@lease.LeaseID">Expiring Soon</button>
                                        <button class="status-btn expired-btn" data-status="2" data-id="@lease.LeaseID">Expired</button>
                                        <button class="status-btn terminated-btn" data-status="4" data-id="@lease.LeaseID">Terminated</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Search and filter
        $('#search-input, #status-filter').on('input change', function () {
            let search = $('#search-input').val().toLowerCase();
            let status = $('#status-filter').val();
            $('#lease-table tbody tr').each(function () {
                if ($(this).hasClass('expanded-row')) return;
                let rowText = $(this).text().toLowerCase();
                let statusText = $(this).find('td:nth-child(2)').text();
                $(this).toggle(rowText.includes(search) && (status === "" || statusText === status));
            });
        });

        // Expand/Collapse row
        $('.view-btn').click(function () {
            let row = $(this).closest('tr');
            let id = row.data('id');
            $('#expanded-' + id).toggle();
        });

        // Change lease status via AJAX
        $('.status-btn').click(function () {
            let leaseId = $(this).data('id');
            let newStatus = $(this).data('status');
            let btn = $(this);

            $.ajax({
                url: '/PropertyManager/UpdateLeaseStatus',
                type: 'POST',
                data: { leaseId: leaseId, status: newStatus },
                success: function () {
                    // Update the main table status cell
                    $('tr[data-id="' + leaseId + '"] td:nth-child(2)').text(btn.text());
                    alert('Lease status updated!');
                },
                error: function () {
                    alert('Error updating lease status.');
                }
            });
        });
    </script>
</body>
