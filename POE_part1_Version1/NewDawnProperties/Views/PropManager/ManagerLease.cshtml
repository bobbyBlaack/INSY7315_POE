@model List<NewDawnProperties.Models.LeaseModel>

@{
    ViewData["Title"] = "Lease Management";
}

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #fafafa;
            margin: 0;
        }

        #navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #E6B566;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 15px 0;
            z-index: 1000;
            font-weight: bold;
        }

            #navbar a {
                color: black;
                text-decoration: none;
                padding: 10px 15px;
            }

                #navbar a:hover {
                    color: white;
                }

        #dashboard-container {
            margin-top: 90px;
            padding: 20px;
        }

        /* Top controls (Search + Filters + Button) */
        #control-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        #search-input {
            width: 40%;
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        #status-filter {
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        #add-lease-btn {
            background-color: #FF9D00;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            color: black;
            font-weight: bold;
        }

            #add-lease-btn:hover {
                background-color: #E68A00;
            }

        /* Summary boxes */
        #summary-section {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }

        .summary-box {
            background-color: #f0f0f0;
            border-radius: 10px;
            padding: 15px;
            flex: 1;
            text-align: center;
        }

        /* Scrollable table */
        #lease-table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            border-radius: 8px;
            overflow: hidden;
        }

            #lease-table th, #lease-table td {
                padding: 10px;
                border-bottom: 1px solid #ddd;
                text-align: center;
            }

            #lease-table th {
                background-color: #E6B566;
            }

        #table-container {
            max-height: 400px;
            overflow-y: auto;
            border-radius: 8px;
            border: 1px solid #ccc;
        }
    </style>
</head>

<body>
    <div id="navbar">
        <a href="#" id="logo">Company Logo</a>
        <a asp-action="PropManDashboard">Dashboard</a>
        <a asp-action="ManagerListing">Update Listings</a>
        <a asp-action="ManagerLease">Manage Leases</a>
        <a asp-action="ManagerEscalation">Escalations</a>
        <a asp-action="ManagerNotif">Notifications</a>
        <a asp-controller="Home" asp-action="Profile">Profile</a>
    </div>

    <div id="dashboard-container">
        <!-- Control Bar -->
        <div id="control-bar">
            <input type="text" id="search-input" placeholder="Search by Tenant or Unit...">
            <select id="status-filter">
                <option value="">All Statuses</option>
                <option value="Active">Active</option>
                <option value="Expiring Soon">Expiring Soon</option>
                <option value="Expired">Expired</option>
                <option value="Terminated">Terminated</option>
            </select>
            <button id="add-lease-btn" onclick="window.location.href='/PropertyManager/AddLease'">+ Add Lease</button>
        </div>

        <!-- Summary Section -->
        <div id="summary-section">
            <div class="summary-box">Active Leases: <strong>@Model.Count(l => l.LeaseStatus == 1)</strong></div>
            <div class="summary-box">Expiring Soon: <strong>@Model.Count(l => l.LeaseStatus == 3)</strong></div>
            <div class="summary-box">Expired: <strong>@Model.Count(l => l.LeaseStatus == 2)</strong></div>
            <div class="summary-box">Terminated: <strong>@Model.Count(l => l.LeaseStatus == 4)</strong></div>
        </div>

        <!-- Scrollable Table -->
        <div id="table-container">
            <table id="lease-table">
                <thead>
                    <tr>
                        <th>Lease ID</th>
                        <th>Status</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Rent</th>
                        <th>Room ID</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lease in Model)
                    {
                        <tr>
                            <td>@lease.LeaseID</td>
                            <td>@lease.LeaseAction</td>
                            <td>@lease.LeaseStart</td>
                            <td>@lease.LeaseEnd</td>
                            <td>R @lease.RentAmount</td>
                            <td>@lease.RoomId</td>
                            <td><button style="padding:5px 10px;">View</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Search and filter logic
        $('#search-input, #status-filter').on('input change', function () {
            let search = $('#search-input').val().toLowerCase();
            let status = $('#status-filter').val();

            $('#lease-table tbody tr').each(function () {
                let rowText = $(this).text().toLowerCase();
                let statusText = $(this).find('td:nth-child(2)').text();

                let matchesSearch = rowText.includes(search);
                let matchesStatus = status === "" || statusText === status;

                $(this).toggle(matchesSearch && matchesStatus);
            });
        });
    </script>
</body>
