<head>
    <style>
        /* ===== Navbar ===== */
        #navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #E6B566;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 15px 0;
            z-index: 1000;
            font-weight: bold;
        }

            #navbar a {
                color: black;
                text-decoration: none;
                padding: 10px 15px;
                transition: color 0.3s;
            }

                #navbar a:hover {
                    color: white;
                }

            #navbar #logo {
                font-size: 20px;
                font-weight: bold;
            }

        /* ===== Page Layout ===== */
        #dashboard-container {
            margin-top: 80px; /* space for fixed navbar */
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* ===== Top Summary Section ===== */
        #summary-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        #property-title {
            font-size: 28px;
            font-weight: bold;
        }

        .summary-box {
            background-color: #f0f0f0;
            border-radius: 10px;
            padding: 15px;
            min-width: 120px;
            text-align: center;
            flex: 1;
        }

        /* ===== Middle Section Grid ===== */
        #middle-section {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
        }

        .scroll-box {
            background-color: #f9f9f9;
            border-radius: 10px;
            padding: 15px;
            max-height: 400px;
            overflow-y: auto;
        }

        /* ===== Bottom Section Grid ===== */
        #bottom-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        #recent-activity, #notes-box {
            background-color: #f9f9f9;
            border-radius: 10px;
            padding: 15px;
            min-height: 250px;
            overflow-y: auto;
        }

        #notes-textarea {
            width: 100%;
            height: 150px;
            border-radius: 5px;
            border: 1px solid #ccc;
            padding: 5px;
        }

        /* ===== Floating AI Chatbot Icon ===== */
        #ai-chatbot {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background-color: #FF9D00;
            color: black;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(0,0,0,0.2);
            transition: 0.3s;
        }

            #ai-chatbot:hover {
                transform: scale(1.1);
            }
    </style>
</head>

<body>

    <!-- ===== Navbar ===== -->
    <div id="navbar">
        <a href="#" id="logo">Company Logo</a>
        <a asp-action="PropManDashboard">Dashboard</a>
        <a asp-action="ManagerListing">Update Listings</a>
        <a asp-action="ManagerLease">Manage Leases</a>
        <a asp-action="ManagerEscalation">Escalations</a>
        <a asp-action="ManagerNotif">Notifications</a>
        <a asp-controller="Home" asp-action="Profile">Profile</a>
    </div>

<h1>Manager Notif</h1>
</body>