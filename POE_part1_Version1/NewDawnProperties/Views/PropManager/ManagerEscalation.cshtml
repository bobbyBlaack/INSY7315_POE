@model List<NewDawnProperties.Models.EscalationModel>
@{
    ViewData["Title"] = "Manager Escalation";
    var actionOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = "Low", Value = "Low" },
        new SelectListItem { Text = "Medium", Value = "Medium" },
        new SelectListItem { Text = "High", Value = "High" },
        new SelectListItem { Text = "Critical", Value = "Critical" }
    };
}

<h1>Escalations</h1>

<!-- Layer 1: Date Range Filter -->
<form method="get">
    <label>Start Date: <input type="date" name="startDate" /></label>
    <label>End Date: <input type="date" name="endDate" /></label>
    <button type="submit">Filter</button>
</form>

<!-- Layer 2: Summary Boxes -->
<div style="display:flex; gap:20px; margin-top:20px;">
    <div class="summary-box">Total: @ViewBag.Total</div>
    <div class="summary-box">High: @ViewBag.High</div>
    <div class="summary-box">Medium: @ViewBag.Medium</div>
    <div class="summary-box">Low: @ViewBag.Low</div>
</div>
<!-- Layer 3: Table of Escalations -->
<table border="1" cellpadding="5" cellspacing="0" style="margin-top:20px; width:100%;">
    <thead>
        <tr>
            <th>Date</th>
            <th>Room</th>
            <th>Category</th>
            <th>Summary</th>
            <th>Action</th>
            <th>Update Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var escalation in Model)
        {
            <tr>
                <td>@escalation.EscalationDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@escalation.RoomId</td>
                <td>@escalation.Category</td>
                <td>@escalation.Summary</td>
                <td>@escalation.Actions</td>
                <td>
                    <form method="post" asp-action="UpdateAction">
                        <input type="hidden" name="id" value="@escalation.EscalationId" />
                        <select name="newAction">
                            @foreach(var option in actionOptions)
                            {
                                <option value="@option.Value" >@option.Text</option>
                            }
                        </select>
                        <button type="submit">Update</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>