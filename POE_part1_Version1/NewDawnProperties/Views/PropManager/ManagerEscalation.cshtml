@model List<NewDawnProperties.Models.EscalationModel>

@{
    ViewData["Title"] = "Manage Escalations";
}

<head>
    <style>
        /* ===== Navbar ===== */
        #navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #E6B566;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 15px 0;
            z-index: 1000;
            font-weight: bold;
        }

            #navbar a {
                color: black;
                text-decoration: none;
                padding: 10px 15px;
                transition: color 0.3s;
            }

                #navbar a:hover {
                    color: white;
                }

            #navbar #logo {
                font-size: 20px;
                font-weight: bold;
            }

        /* ===== Page Layout ===== */
        #dashboard-container {
            margin-top: 80px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        #property-title {
            font-size: 28px;
            font-weight: bold;
        }

        /* Summary Boxes */
        .summary-box {
            background-color: #f0f0f0;
            border-radius: 10px;
            padding: 15px;
            min-width: 120px;
            text-align: center;
            flex: 1;
            font-size: 18px;
            font-weight: bold;
        }

        /* Escalation Scroll Container */
        .scroll-box {
            background-color: lightgray;
            border-radius: 10px;
            padding: 15px;
            max-height: 500px;
            overflow-y: auto;
        }

        /* Escalation Item */
        .escalation-card {
            background-color: white;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            box-shadow: 0px 0px 4px rgba(0,0,0,0.2);
        }

        .action-btn {
            padding: 6px 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            margin-right: 5px;
            font-weight: bold;
        }

        .low-btn {
            background-color: #b3ffb3;
        }

        .medium-btn {
            background-color: #ffd480;
        }

        .high-btn {
            background-color: #ff9999;
        }

        .critical-btn {
            background-color: #ff4d4d;
            color: white;
        }

        .filter-form {
            background-color: lightgray;
            padding: 15px;
            border-radius: 12px;
            width: 50%;
        }

            .filter-form input,
            .filter-form button {
                padding: 8px;
                border-radius: 6px;
                border: 1px solid #ccc;
                margin: 5px 0;
            }

            .filter-form button {
                background-color: #E6B566;
                cursor: pointer;
                font-weight: bold;
            }

                .filter-form button:hover {
                    background-color: #d39f58;
                }
    </style>
</head>


<body>

    <!-- ===== NAVBAR ===== -->
    <div id="navbar">
        <a href="#" id="logo">Company Logo</a>
        <a asp-action="PropManDashboard">Dashboard</a>
        <a asp-action="ManagerListing">Update Listings</a>
        <a asp-action="ManagerLease">Manage Leases</a>
        <a asp-action="ManagerEscalation">Escalations</a>
        <a asp-action="ManagerNotif">Notifications</a>
        <a asp-controller="Home" asp-action="Profile">Profile</a>
    </div>


    <!-- ===== MAIN CONTAINER ===== -->
    <div id="dashboard-container">

        <!-- Page Title -->
        <h1 id="property-title">Manage Escalations</h1>


        <!-- ===== FILTER FORM ===== -->
        <div class="filter-form">
            <form method="get">
                <label>Start Date:</label>
                <input type="date" name="startDate" />

                <label>End Date:</label>
                <input type="date" name="endDate" />

                <button type="submit">Filter</button>
            </form>
        </div>


        <!-- ===== SUMMARY BOXES ===== -->
        <div style="display:flex; gap:20px; margin-top:10px;">
            <div class="summary-box">Total: @ViewBag.Total</div>
            <div class="summary-box">High: @ViewBag.High</div>
            <div class="summary-box">Medium: @ViewBag.Medium</div>
            <div class="summary-box">Low: @ViewBag.Low</div>
        </div>


        <!-- ===== ESCALATION LIST ===== -->
        <div class="scroll-box">
            <h2 style="margin-bottom: 10px;">Escalations</h2>

            @foreach (var item in Model)
            {
                <div class="escalation-card">
                    <p><strong>Date:</strong> @item.EscalationDate.ToString("yyyy-MM-dd HH:mm")</p>
                    <p><strong>Room:</strong> @item.RoomId</p>
                    <p><strong>Category:</strong> @item.Category</p>
                    <p><strong>Summary:</strong> @item.Summary</p>
                    <p><strong>Action Level:</strong> @item.Actions</p>

                    <form asp-action="UpdateAction" method="post">
                        <input type="hidden" name="id" value="@item.EscalationId" />

                        <button type="submit" name="newAction" value="Low" class="action-btn low-btn">Low</button>
                        <button type="submit" name="newAction" value="Medium" class="action-btn medium-btn">Medium</button>
                        <button type="submit" name="newAction" value="High" class="action-btn high-btn">High</button>
                        <button type="submit" name="newAction" value="Critical" class="action-btn critical-btn">Critical</button>
                    </form>
                </div>
            }

        </div>

    </div>

</body>
