@model List<NewDawnProperties.Models.EscalationModel>

<h1>Escalations</h1>

<!-- Optional Date Filter -->
<form method="get">
    <label>Start Date: <input type="date" name="startDate" /></label>
    <label>End Date: <input type="date" name="endDate" /></label>
    <button type="submit">Filter</button>
</form>

<!-- Summary Boxes -->
<div style="display:flex; gap:20px; margin-top:20px;">
    <div>Total: @ViewBag.Total</div>
    <div>High: @ViewBag.High</div>
    <div>Medium: @ViewBag.Medium</div>
    <div>Low: @ViewBag.Low</div>
</div>

<!-- Escalations Table -->
<table border="1" cellpadding="5" cellspacing="0" style="margin-top:20px; width:100%;">
    <thead>
        <tr>
            <th>Date</th>
            <th>Room</th>
            <th>Category</th>
            <th>Summary</th>
            <th>Action</th>
            <th>Update Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var escalation in Model)
        {
            <tr>
                <td>@escalation.EscalationDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@escalation.RoomId</td>
                <td>@escalation.Category</td>
                <td>@escalation.Summary</td>
                <td>@escalation.Actions</td>
                <td>
                    <form asp-action="UpdateAction" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@escalation.EscalationId" />
                        <button type="submit" name="newAction" value="Low">Low</button>
                        <button type="submit" name="newAction" value="Medium">Medium</button>
                        <button type="submit" name="newAction" value="High">High</button>
                        <button type="submit" name="newAction" value="Critical">Critical</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
