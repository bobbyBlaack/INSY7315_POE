@{
    ViewData["Title"] = Localizer["SignUpPage"];
}
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<div class="signup-page">
    <div class="signup-card">
        <h1>@Localizer["SignUp"]</h1>
        <form method="post" class="signup-form">
            <div class="form-column">
                <label>@Localizer["Email"]:</label>
                <input type="email" name="email" required>

                <label>@Localizer["Password"]:</label>
                <input type="password" name="password" required>

                <label>@Localizer["FullName"]:</label>
                <input type="text" name="fullname" required>

                <label>@Localizer["PhoneNumber"]:</label>
                <input type="tel" name="phone" required>
            </div>

            <div class="form-divider"></div>

            <div class="form-column">
                <label>@Localizer["SelectLocation"]:</label>
                <select name="location" required>
                    <option>@Localizer["BlueHills"]</option>
                    <option>@Localizer["Birchleigh"]</option>
                    <option>@Localizer["Florida"]</option>
                </select>

                <label>@Localizer["BlockBuilding"]</label>
                <input type="text" name="block">

                <label>@Localizer["UnitNumber"]</label>
                <input type="text" name="unit">

                <label>@Localizer["SecurityCode"]</label>
                <input type="text" name="security" placeholder="@Localizer["SecurityCodePlaceholder"]">
            </div>
        </form>

        <div class="signup-actions">
            <p>
                @Localizer["AlreadyHaveAccount"]
                <a asp-controller="Home" asp-action="Index">@Localizer["Login"]</a>
            </p>
            <button type="submit" class="signup-btn">@Localizer["SignUpButton"]</button>
        </div>
    </div>
</div>