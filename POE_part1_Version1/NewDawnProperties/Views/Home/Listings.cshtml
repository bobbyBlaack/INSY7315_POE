@model List<NewDawnProperties.Models.PropertyModel>

@{
    ViewData["Title"] = "Current Listings";
}

<div class="listings-page">
    <div class="overlay">
        <div class="listings-container">
            <h1 class="listings-heading">Available Properties</h1>

            @if (Model.Any())
            {
                <div class="listing-grid">
                    @foreach (var property in Model)
                    {
                        <div class="listing-card">
                            <div class="listing-image" style="background-image:url('@property.ImageUrl');"></div>
                            <h3>@property.Name</h3>
                            <p><strong>Location:</strong> @property.Location</p>
                            <p>@property.Description</p>
                            <p><strong>Price:</strong> R @property.Price</p>
                            <a href="#">More details</a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>No properties found at the moment. Please check back later.</p>
            }
        </div>
    </div>
</div>